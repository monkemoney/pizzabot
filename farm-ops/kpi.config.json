{
  "_doc": "KPI catalogue as data — read by scripts/kpi.mjs (kit 1.3). direction: up = higher is better, down = lower is better, zero = must be 0. dept: timing | problems | both | owner. threshold breaches open a case (class monitor) when kpi.mjs runs with --open-cases.",
  "cadence": "weekly",
  "kpis": [
    {"id": "A1", "domain": "grants", "name": "Run health", "formula": "runs with status=ok / runs in period", "source": "docs/ops/tools/grants/runs.csv", "unit": "%", "target": 100, "direction": "up", "threshold": 100, "dept": "problems"},
    {"id": "A2", "domain": "grants", "name": "Fetched per run", "formula": "mean fetched (ok runs)", "source": "runs.csv:fetched", "unit": "rows", "target": null, "direction": "up", "threshold": 1, "dept": "problems"},
    {"id": "A3", "domain": "grants", "name": "Stale ratio", "formula": "stale / total after pull", "source": "runs.csv:stale,total", "unit": "%", "target": 10, "direction": "down", "threshold": 50, "dept": "problems"},
    {"id": "A4", "domain": "grants", "name": "Real candidates (≥70)", "formula": "rows score≥70 minus reviewer-flagged false positives", "source": "runs.csv:score70 + digest reviewer section", "unit": "n", "target": 3, "direction": "up", "threshold": null, "dept": "owner"},
    {"id": "A5", "domain": "grants", "name": "False positives at 50+", "formula": "reviewer-flagged rows ≥50 per run", "source": "digest.md reviewer section", "unit": "n", "target": 2, "direction": "down", "threshold": 4, "dept": "problems"},
    {"id": "A6", "domain": "grants", "name": "Reviewer minutes per digest", "formula": "session minutes of the weekly review", "source": "docs/okr/agent-usage.log (who=routine review)", "unit": "min", "target": 20, "direction": "down", "threshold": 40, "dept": "timing"},
    {"id": "A7", "domain": "grants", "name": "Decisions to Limor per week", "formula": "digest decisions block count", "source": "digest.md", "unit": "n", "target": 3, "direction": "up", "threshold": null, "dept": "owner"},
    {"id": "A8", "domain": "grants", "name": "Decision latency", "formula": "digest date → decision column set, median days", "source": "opportunities.csv:decision + changes.log", "unit": "days", "target": 7, "direction": "down", "threshold": 14, "dept": "timing"},
    {"id": "A9", "domain": "grants", "name": "Submissions / LOI per month", "formula": "decision=submitted in period", "source": "opportunities.csv:decision", "unit": "n", "target": 3, "direction": "up", "threshold": null, "dept": "owner"},
    {"id": "A10", "domain": "grants", "name": "Submissions → invitations", "formula": "invited or won / submitted (rolling 90d)", "source": "opportunities.csv:decision", "unit": "%", "target": 25, "direction": "up", "threshold": null, "dept": "owner"},
    {"id": "A11", "domain": "grants", "name": "$ awarded / $ requested", "formula": "sum won / sum submitted amounts", "source": "opportunities.csv:amount_max,decision", "unit": "%", "target": null, "direction": "up", "threshold": null, "dept": "owner"},
    {"id": "A12", "domain": "grants", "name": "Missed deadlines", "formula": "approved rows whose deadline passed without submitted/rejected", "source": "opportunities.csv:deadline,decision", "unit": "n", "target": 0, "direction": "zero", "threshold": 1, "dept": "both"},
    {"id": "B1", "domain": "nsgp", "name": "Obligations with real dates", "formula": "rows with due set / rows kind=deadline|report", "source": "docs/ops/tools/grants/obligations.csv", "unit": "%", "target": 100, "direction": "up", "threshold": 80, "dept": "problems"},
    {"id": "B2", "domain": "nsgp", "name": "Days to next obligation", "formula": "min(due − today) over open rows", "source": "obligations.csv:due,status", "unit": "days", "target": null, "direction": "up", "threshold": 3, "dept": "timing"},
    {"id": "B3", "domain": "nsgp", "name": "Overdue obligations", "formula": "due < today and status≠done", "source": "obligations.csv", "unit": "n", "target": 0, "direction": "zero", "threshold": 1, "dept": "both"},
    {"id": "B4", "domain": "nsgp", "name": "EHP before purchase", "formula": "purchases with EHP letter date < purchase date / purchases", "source": "ledger.py category nsgp + obligations notes", "unit": "%", "target": 100, "direction": "up", "threshold": 100, "dept": "problems"},
    {"id": "B5", "domain": "nsgp", "name": "Reimbursement cycle", "formula": "invoice date → reimbursement received, median days", "source": "money_summary.csv (Day 3) + FMFW dates", "unit": "days", "target": 45, "direction": "down", "threshold": 90, "dept": "timing"},
    {"id": "B6", "domain": "nsgp", "name": "Award spent or approved", "formula": "approved purchases $ / 190000", "source": "obligations.csv + ledger nsgp", "unit": "%", "target": null, "direction": "up", "threshold": null, "dept": "owner"},
    {"id": "C1", "domain": "extraction", "name": "Step outcomes per run", "formula": "ok / fail / workaround / skip counts", "source": "RUNREPORT.md (pasted) → runlog summary", "unit": "n", "target": null, "direction": "up", "threshold": null, "dept": "problems"},
    {"id": "C2", "domain": "extraction", "name": "Owner hands per run", "formula": "Limor touch points (Touch ID, answers, screen)", "source": "RUNREPORT.md", "unit": "n", "target": 3, "direction": "down", "threshold": 5, "dept": "timing"},
    {"id": "C3", "domain": "extraction", "name": "Steps over 30 min", "formula": "steps with duration > 30 min", "source": "RUNREPORT.md", "unit": "n", "target": 0, "direction": "down", "threshold": 2, "dept": "timing"},
    {"id": "C4", "domain": "extraction", "name": "Schema drift events", "formula": "manifest schema_drift flags", "source": "manifest.json (via RUNREPORT)", "unit": "n", "target": 0, "direction": "zero", "threshold": 1, "dept": "problems"},
    {"id": "C5", "domain": "extraction", "name": "Evidence coverage", "formula": "events with grade R / all events, per year", "source": "events_seed_share.csv + calendar_events.csv", "unit": "%", "target": 60, "direction": "up", "threshold": null, "dept": "owner"},
    {"id": "C6", "domain": "extraction", "name": "PII caught in shareable output", "formula": "privacy assert failures + manual finds", "source": "runlog notes refused + review", "unit": "n", "target": 0, "direction": "zero", "threshold": 1, "dept": "problems"},
    {"id": "D1", "domain": "owner", "name": "Open decisions and median age", "formula": "count; median(today − When)", "source": "docs/DECISIONS-OPEN.md", "unit": "n / days", "target": 8, "direction": "down", "threshold": 15, "dept": "timing"},
    {"id": "D2", "domain": "owner", "name": "Overdue decisions", "formula": "deadline < today", "source": "DECISIONS-OPEN.md", "unit": "n", "target": 0, "direction": "down", "threshold": 3, "dept": "timing"},
    {"id": "D3", "domain": "owner", "name": "Silence-rule fires", "formula": "reversible items that took the default", "source": "DECISIONS.md '(default, no answer)'", "unit": "n", "target": null, "direction": "down", "threshold": 3, "dept": "problems"},
    {"id": "D4", "domain": "owner", "name": "Loop rounds", "formula": "same ask raised on ≥2 days without a route change", "source": "changes.log + INBOX.md (kit 1.2)", "unit": "n", "target": 0, "direction": "zero", "threshold": 1, "dept": "problems"},
    {"id": "D5", "domain": "owner", "name": "Reports sent", "formula": "owner reports / working days", "source": "docs/reports/*.md", "unit": "%", "target": 100, "direction": "up", "threshold": 60, "dept": "timing"},
    {"id": "D6", "domain": "owner", "name": "Limor minutes per week", "formula": "sum of sheet estimates for done steps", "source": "docs/ceo/*.md stamps [done]", "unit": "min", "target": 75, "direction": "down", "threshold": 120, "dept": "timing"},
    {"id": "E1", "domain": "process", "name": "Roles idle without reason", "formula": "ledger roles paused/closed > pausedAlertHours", "source": "docs/okr/delivery-ledger.md", "unit": "n", "target": 0, "direction": "zero", "threshold": 1, "dept": "both"},
    {"id": "E2", "domain": "process", "name": "Brief cycle time", "formula": "resumed → closed-for-day per brief, median hours", "source": "delivery-ledger.md", "unit": "h", "target": 8, "direction": "down", "threshold": 48, "dept": "timing"},
    {"id": "E3", "domain": "process", "name": "Gate pass rate and duration", "formula": "verdict n/n share; median ms", "source": "docs/okr/gate-runs.log", "unit": "% / ms", "target": 90, "direction": "up", "threshold": 70, "dept": "both"},
    {"id": "E4", "domain": "process", "name": "Lint fails per week", "formula": "gate lines with FAIL: docs lint", "source": "gate-runs.log", "unit": "n", "target": 0, "direction": "down", "threshold": 3, "dept": "problems"},
    {"id": "E5", "domain": "process", "name": "Cases: open, MTTR", "formula": "open count; median(closed − opened) days", "source": "docs/cases/LOG.md", "unit": "n / days", "target": 7, "direction": "down", "threshold": 14, "dept": "both"},
    {"id": "E6", "domain": "process", "name": "Recurrence", "formula": "same cause class twice within 30 days in one area", "source": "LOG.md:class,area,date", "unit": "n", "target": 0, "direction": "zero", "threshold": 1, "dept": "problems"},
    {"id": "E7", "domain": "process", "name": "Cases without a guard", "formula": "guard empty or 'to come'", "source": "LOG.md:guard", "unit": "n", "target": 0, "direction": "down", "threshold": 3, "dept": "problems"},
    {"id": "E8", "domain": "process", "name": "Unchecked by Debug", "formula": "rows not ✓G older than 7 days", "source": "LOG.md:checked", "unit": "n", "target": 0, "direction": "down", "threshold": 5, "dept": "problems"},
    {"id": "E9", "domain": "cost", "name": "Cost per week", "formula": "sum tokens → $ (model rates) + session $ reported", "source": "agent-usage.log + session usage", "unit": "$", "target": 60, "direction": "down", "threshold": 120, "dept": "timing"},
    {"id": "E10", "domain": "cost", "name": "Cost per delivered brief", "formula": "week $ / closed-for-day lines", "source": "agent-usage.log + ledger", "unit": "$", "target": 15, "direction": "down", "threshold": 40, "dept": "timing"}
  ]
}
